# ==============================================================================
# Environment Configuration for Multimodal Graph RAG System
# ==============================================================================

# Application Settings
APP_ENV=development
APP_NAME="Multimodal Graph RAG Engine"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-super-secret-key-32chars

# Task Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Observability & Tracing (OpenTelemetry / Langfuse)
TELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=multimodal-graph-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_TEXT=multimodal_rag_text
QDRANT_COLLECTION_IMAGE=multimodal_rag_images

# Object Storage (MinIO / S3 for Multimodal Media Assets)
STORAGE_BACKEND=local # options: local, s3, minio
LOCAL_STORAGE_PATH=./data/media_store
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=multimodal-rag-assets
S3_REGION=us-east-1

# LLM & Vision Language Model Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Groq High-Speed LLM Inference
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM Multimodal & Vision
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model Selection
DEFAULT_LLM_MODEL=qwen/qwen3.8-27b
DEFAULT_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
DEFAULT_TEXT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_VISION_EMBEDDING_MODEL=clip-ViT-B/32
SPARSE_EMBEDDING_MODEL=bm25 # options: bm25, splade

# Graph RAG Extraction & Community Parameters
GRAPH_EXTRACTION_MAX_GLEANINGS=1
GRAPH_COMMUNITY_MAX_LEVEL=3
GRAPH_COMMUNITY_ALGORITHM=leiden # options: leiden, louvain

# Hybrid Retrieval Settings (Vector + Sparse + Graph)
RETRIEVAL_TOP_K_VECTORS=10
RETRIEVAL_TOP_K_SPARSE=10
RETRIEVAL_TOP_K_GRAPH_NODES=10
RETRIEVAL_RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
